# Fixed: Redis amb autenticacio i bind local
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends redis-server && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 appuser

# Configuracio segura
RUN sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf && \
    sed -i 's/^protected-mode no/protected-mode yes/' /etc/redis/redis.conf && \
    echo "requirepass S3cur3_R3d1s_P4ss!" >> /etc/redis/redis.conf && \
    echo "rename-command FLUSHALL \"\"" >> /etc/redis/redis.conf && \
    echo "rename-command CONFIG \"\"" >> /etc/redis/redis.conf && \
    echo "rename-command DEBUG \"\"" >> /etc/redis/redis.conf

# HEALTHCHECK
HEALTHCHECK --interval=30s --timeout=3s \
  CMD redis-cli -a S3cur3_R3d1s_P4ss! ping || exit 1

USER appuser
EXPOSE 6379

CMD ["redis-server", "/etc/redis/redis.conf", "--user", "redisuser", "--daemonize", "no"]
