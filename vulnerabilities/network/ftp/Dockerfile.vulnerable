FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    build-essential \
    libpam0g-dev \
    libcap-dev \
    libcrypt-dev \
    ncat \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN wget https://security.appspot.com/downloads/vsftpd-2.3.4.tar.gz && \
    tar -xzf vsftpd-2.3.4.tar.gz && \
    cd vsftpd-2.3.4 && \
    # FIX: el script vsf_findlibs.sh del 2011 busca libpam i libcap a rutes
    # antigues (/lib, /usr/lib) pero a Ubuntu modern son a /usr/lib/x86_64-linux-gnu.
    # Substituim la deteccio per una llista explicita de libs.
    # A mes glibc moderna no exporta crypt() — cal -lcrypt explicitament.
    sed -i 's|^LIBS\t=\t`./vsf_findlibs.sh`|LIBS\t=\t-lcrypt -lpam -lcap|' Makefile && \
    make && \
    cp vsftpd /usr/local/sbin/ && \
    cd / && rm -rf /tmp/vsftpd-2.3.4*

# Configuracio vulnerable
# IMPORTANT: vsftpd 2.3.4 NO accepta directives modernes com seccomp_sandbox,
# allow_writeable_chroot, etc. Nomes les que ell coneixia el 2011.
RUN cat > /etc/vsftpd.conf << 'EOF'
listen=YES
listen_ipv6=NO
anonymous_enable=YES
local_enable=YES
write_enable=YES
anon_upload_enable=YES
anon_mkdir_write_enable=YES
dirmessage_enable=YES
xferlog_enable=YES
secure_chroot_dir=/var/run/vsftpd/empty
pam_service_name=vsftpd
ftpd_banner=(vsFTPd 2.3.4)
EOF

# vsftpd 2.3.4 necessita:
#   1. /etc/pam.d/vsftpd  (servei PAM)
#   2. usuari 'ftp' al sistema
#   3. usuari 'nobody' (per al privilege separation)
#   4. directori secure_chroot_dir buit i no escrivible
RUN cat > /etc/pam.d/vsftpd << 'EOF'
auth    required        pam_unix.so
account required        pam_unix.so
EOF

RUN mkdir -p /var/run/vsftpd/empty && \
    mkdir -p /var/ftp/pub && \
    chmod 555 /var/ftp && \
    chmod 777 /var/ftp/pub && \
    (id nobody >/dev/null 2>&1 || useradd -M -s /usr/sbin/nologin nobody) && \
    (id ftp    >/dev/null 2>&1 || useradd -M -d /var/ftp -s /usr/sbin/nologin ftp)

# Listener que emula el backdoor del port 6200 (shell root)
RUN cat > /usr/local/sbin/backdoor-listener.sh << 'EOF'
#!/bin/bash
while true; do
    ncat -lp 6200 -e /bin/sh --allow 2>/dev/null
    sleep 1
done
EOF
RUN chmod +x /usr/local/sbin/backdoor-listener.sh

EXPOSE 21 6200

CMD ["bash", "-c", "/usr/local/sbin/backdoor-listener.sh & exec /usr/local/sbin/vsftpd /etc/vsftpd.conf"]
