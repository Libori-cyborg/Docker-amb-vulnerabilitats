# Fixed: vsftpd versio actualitzada i configuracio segura
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    vsftpd curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 ftpuser && \
    echo 'ftpuser:FTP_S3cur3!' | chpasswd

# Configuracio segura
RUN cat > /etc/vsftpd.conf << 'EOF'
listen=YES
anonymous_enable=NO
local_enable=YES
write_enable=NO
chroot_local_user=YES
allow_writeable_chroot=NO
ssl_enable=YES
force_local_data_ssl=YES
force_local_logins_ssl=YES
pasv_enable=YES
pasv_min_port=40000
pasv_max_port=40100
userlist_enable=YES
userlist_deny=NO
userlist_file=/etc/vsftpd.userlist
EOF

RUN echo "ftpuser" > /etc/vsftpd.userlist

# HEALTHCHECK
HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f ftp://localhost/ || exit 1

USER ftpuser
EXPOSE 21
CMD ["/usr/sbin/vsftpd", "/etc/vsftpd.conf"]
