# Vulnerable: Nginx amb directory listing i informacio exposada
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y nginx

# Configuracio vulnerable
RUN cat > /etc/nginx/sites-available/default << 'EOF'
server {
    listen 80;
    root /var/www/html;

    # Exposar versio del servidor
    server_tokens on;

    # Directory listing activat
    location / {
        autoindex on;
        autoindex_exact_size on;
    }

    # Fitxers de configuracio accessibles
    location ~ /\.(conf|env|git|sql|bak) {
        allow all;
    }
}
EOF

# Afegir fitxers sensibles per demostrar l'exposicio
RUN mkdir -p /var/www/html && \
    echo "DB_PASSWORD=secret123" > /var/www/html/.env && \
    echo "config data" > /var/www/html/config.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
